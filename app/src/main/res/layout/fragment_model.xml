<?xml version="1.0" encoding="utf-8"?>
<!--
    Virtual model screen. The model is the user's own photo: without one there is
    nothing to draw, so the screen asks for a photo before anything else. Chips
    rather than a spinner so every size is visible at a glance.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.example.runway.ui.components.ScreenHeaderView
            android:id="@+id/modelHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.example.runway.ui.components.ModelPreviewView
            android:id="@+id/modelPreview"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/modelPhotoEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:paddingVertical="16dp"
            android:text="@string/rw_model_photo_required"
            android:textColor="?android:attr/textColorSecondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/modelPhotoButton"
                style="@style/Widget.Runway.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/rw_model_photo_add" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/modelRemovePhotoButton"
                style="@style/Widget.Runway.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rw_model_photo_remove"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/modelPhotoHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- Read from the photo, not chosen. -->
        <TextView
            android:id="@+id/modelBuildLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:text="@string/rw_model_top_size"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/modelTopSizeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            app:singleSelection="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:text="@string/rw_model_bottom_size"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/modelBottomSizeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            app:singleSelection="true" />

        <TextView
            android:id="@+id/modelHeightLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:textStyle="bold" />

        <com.google.android.material.slider.Slider
            android:id="@+id/modelHeightSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:stepSize="1"
            android:valueFrom="120"
            android:valueTo="220" />

        <TextView
            android:id="@+id/modelWeightLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:textStyle="bold" />

        <com.google.android.material.slider.Slider
            android:id="@+id/modelWeightSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:stepSize="1"
            android:valueFrom="30"
            android:valueTo="250" />

        <TextView
            android:id="@+id/modelShoeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:textStyle="bold" />

        <com.google.android.material.slider.Slider
            android:id="@+id/modelShoeSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:stepSize="1"
            android:valueFrom="33"
            android:valueTo="50" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:text="@string/rw_model_wardrobe"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/modelWardrobeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp" />

        <com.example.runway.ui.components.EmptyStateView
            android:id="@+id/modelWardrobeEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- One line per worn garment saying how its size compares with the user's. -->
        <!-- The paid, photoreal render. Everything above it is free and instant. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/modelRenderButton"
            style="@style/Widget.Runway.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:text="@string/rw_model_render" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/modelClearRenderButton"
            style="@style/Widget.Runway.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:text="@string/rw_model_render_clear"
            android:visibility="gone" />

        <TextView
            android:id="@+id/modelRenderHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- Keeps what is on the model, with its render, as a saved outfit. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/modelSaveOutfitButton"
            style="@style/Widget.Runway.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:text="@string/rw_model_save_outfit" />

        <TextView
            android:id="@+id/modelWornSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:textColor="?android:attr/textColorSecondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/modelClearButton"
                style="@style/Widget.Runway.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/rw_model_clear" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/modelSaveButton"
                style="@style/Widget.Runway.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rw_model_save" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
