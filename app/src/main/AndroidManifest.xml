<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".RunwayApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Runway">

        <!-- Single Activity: hosts the whole nav graph, including auth (splash / onboarding /
             sign in / biometric) - see runway_nav_graph.xml. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Runway.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Component catalog. Not exported - it is only opened from inside the app. -->
        <activity
            android:name=".ui.catalog.CatalogActivity"
            android:exported="false"
            android:label="@string/rw_catalog_title"
            android:parentActivityName=".MainActivity" />

    </application>

</manifest>
